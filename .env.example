# Select the model provider used by the brain module.
JARVIS_LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Local data stays on this computer. Use absolute paths if preferred.
JARVIS_WORKSPACE=~/JarvisWorkspace
JARVIS_DATABASE_PATH=
JARVIS_DEFAULT_CITY=

# Local educational knowledge base and embedding model.
JARVIS_KNOWLEDGE_DIR=.\data\educational
JARVIS_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
JARVIS_DOWNLOAD_STAGING_DIR=.\data\download_staging
JARVIS_AUTO_INDEX_APPROVED_SOURCES=true

# Voice settings are read now so the later voice module has one config source.
JARVIS_TEXT_ONLY=true
JARVIS_WAKE_WORD=Jarvis
JARVIS_VOICE_RATE=175
JARVIS_REQUEST_TIMEOUT_SECONDS=15
